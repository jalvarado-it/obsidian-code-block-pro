{
	"name": "code-block-pro",
	"version": "0.6.1",
	"description": "Enhance fenced code blocks with copy buttons and language labels.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"deploy": "npm run build && node scripts/install.mjs",
		"install:vault": "node scripts/install.mjs",
		"lint": "eslint .",
		"audit": "npm audit",
		"sbom": "npm sbom --sbom-format cyclonedx --sbom-type application --package-lock-only > sbom.cdx.json",
		"sbom:spdx": "npm sbom --sbom-format spdx --sbom-type application --package-lock-only > sbom.spdx.json",
		"sbom:runtime": "npm sbom --sbom-format cyclonedx --sbom-type application --package-lock-only --omit=dev > sbom.runtime.cdx.json",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"code-block",
		"syntax-highlighting"
	],
	"author": "Jesus Alvarado",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"overrides": {
		"moment": "^2.31.0"
	},
	"devDependencies": {
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.19.2",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.14.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.1"
	}
}
